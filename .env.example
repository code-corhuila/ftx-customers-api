# Variables ftx-customers-api reads. Placeholders only: never real values.
# In a deployment they come from the env file of ftx-infra-postgres (env/dev.env, env/qa.env,
# env/main.env), which is not versioned.
CUSTOMERS_DB_URL=jdbc:postgresql://localhost:5432/ftx
CUSTOMERS_DB_USER=customers_app
CUSTOMERS_DB_PASSWORD=<customers-app-password>

# RSA private key, PKCS#8, 2048 bits or more, on one line without the BEGIN/END lines.
CUSTOMERS_JWT_PRIVATE_KEY=<one-line-pkcs8-key>
CUSTOMERS_JWT_KEY_ID=<key-id>
# Local development only: a new key on every start instead of the two variables above.
CUSTOMERS_JWT_EPHEMERAL=false

# First administrator: all three or none. The hash is BCrypt with strength 12 or more.
# Inside a Compose env file, wrap the hash in single quotes: it contains "$".
CUSTOMERS_BOOTSTRAP_ADMIN_NAME=<full-name>
CUSTOMERS_BOOTSTRAP_ADMIN_EMAIL=<email>
CUSTOMERS_BOOTSTRAP_ADMIN_PASSWORD_HASH='<bcrypt-hash>'
